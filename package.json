{
	"name": "recipe-hub",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "pnpm run --no-bail \"/^lint:/\"",
		"lint:boundaries": "depcruise --config .dependency-cruiser.ts src",
		"lint:code": "eslint .",
		"lint:format": "prettier --check .",
		"lint:migrations": "drizzle-kit check",
		"format": "prettier --write .",
		"typecheck": "next typegen && tsc --noEmit",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:bootstrap": "tsx --tsconfig scripts/tsconfig.json scripts/bootstrap.ts",
		"db:seed": "tsx --tsconfig scripts/tsconfig.json scripts/seed.ts"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@better-auth/passkey": "^1.7.7",
		"@vercel/blob": "^2.8.1",
		"@vercel/functions": "^3.9.11",
		"better-auth": "^1.7.7",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.4.0",
		"drizzle-orm": "^0.45.4",
		"lucide-react": "^1.54.0",
		"next": "16.4.0",
		"next-themes": "^0.4.6",
		"pg": "^8.23.1",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"resend": "^6.32.1",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.8",
		"@next/env": "16.4.0",
		"@tailwindcss/turbopack": "^4",
		"@types/node": "^24",
		"@types/pg": "^8.23.1",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"dependency-cruiser": "^18.5.0",
		"drizzle-kit": "^0.31.11",
		"eslint": "^9",
		"eslint-config-next": "16.4.0",
		"eslint-plugin-perfectionist": "^5",
		"prettier": "^3",
		"prettier-plugin-tailwindcss": "^0.8",
		"schema-dts": "^2.1.0",
		"shadcn": "^4",
		"tailwindcss": "^4",
		"tsx": "^4.23.15",
		"typescript": "^5",
		"vitest": "^5"
	},
	"engines": {
		"node": "24.x"
	},
	"packageManager": "pnpm@12.10.1"
}
