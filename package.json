{
	"name": "recipe-hub",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "pnpm run --no-bail \"/^lint:/\"",
		"lint:code": "eslint .",
		"lint:format": "prettier --check .",
		"format": "prettier --write .",
		"typecheck": "next typegen && tsc --noEmit",
		"test": "vitest run --passWithNoTests"
	},
	"dependencies": {
		"next": "16.4.0",
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"devDependencies": {
		"@tailwindcss/turbopack": "^4",
		"@types/node": "^24",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "16.4.0",
		"eslint-plugin-perfectionist": "^5",
		"prettier": "^3",
		"prettier-plugin-tailwindcss": "^0.8",
		"tailwindcss": "^4",
		"typescript": "^5",
		"vitest": "^5"
	},
	"engines": {
		"node": "24.x"
	},
	"packageManager": "pnpm@12.10.1"
}
