{
	"name": "recipe-hub",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "pnpm run --no-bail \"/^lint:/\"",
		"lint:boundaries": "depcruise --config .dependency-cruiser.ts src",
		"lint:code": "eslint .",
		"lint:format": "prettier --check .",
		"lint:migrations": "drizzle-kit check",
		"format": "prettier --write .",
		"typecheck": "next typegen && tsc --noEmit",
		"test": "pnpm run --sequential --no-bail \"/^test:/\"",
		"test:e2e": "playwright test",
		"test:unit": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:bootstrap": "tsx --tsconfig scripts/tsconfig.json scripts/bootstrap/bootstrap.ts",
		"db:seed": "tsx --tsconfig scripts/tsconfig.json scripts/seed/seed.ts",
		"db:reparse-ingredients": "tsx --tsconfig scripts/tsconfig.json scripts/reparse-ingredients/reparse-ingredients.ts",
		"evaluate": "tsx --tsconfig scripts/tsconfig.json scripts/evaluate/evaluate.ts"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@better-auth/passkey": "^1.7.7",
		"@vercel/blob": "^2.8.1",
		"@vercel/functions": "^3.9.11",
		"ai": "^7.0.137",
		"better-auth": "^1.7.7",
		"botid": "^1.5.11",
		"cheerio": "^1.2.0",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.4.0",
		"drizzle-orm": "^0.45.4",
		"embla-carousel-react": "^8.6.0",
		"encoding-sniffer": "^1.0.2",
		"guarded-fetch": "^0.1.5",
		"html-to-text": "^10.0.1",
		"iso8601-duration": "^2.2.0",
		"lucide-react": "^1.54.0",
		"next": "16.4.0",
		"next-themes": "^0.4.6",
		"parse-ingredient": "^3.0.0",
		"pg": "^8.23.1",
		"pluralize": "^8.0.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-email": "^6.11.1",
		"react-zoom-pan-pinch": "^4.2.0",
		"resend": "^6.32.1",
		"sharp": "^0.35.5",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.8",
		"@next/env": "16.4.0",
		"@playwright/test": "1.64.1",
		"@simplewebauthn/server": "^13.3.3",
		"@tailwindcss/turbopack": "^4",
		"@tailwindcss/vite": "^4",
		"@types/html-to-text": "^9.0.4",
		"@types/node": "^24",
		"@types/pg": "^8.23.1",
		"@types/pluralize": "^0.0.33",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitest/browser-playwright": "5.0.3",
		"@vitest/ui": "5.0.3",
		"dependency-cruiser": "^18.5.0",
		"drizzle-kit": "^0.31.11",
		"eslint": "^9",
		"eslint-config-next": "16.4.0",
		"eslint-plugin-perfectionist": "^5",
		"leven": "^4.1.0",
		"playwright": "1.64.1",
		"prettier": "^3",
		"prettier-plugin-tailwindcss": "^0.8",
		"schema-dts": "^2.1.0",
		"shadcn": "^4",
		"tailwindcss": "^4",
		"tsx": "^4.23.15",
		"typescript": "^5",
		"vitest": "5.0.3",
		"vitest-browser-react": "^2.3.0"
	},
	"engines": {
		"node": "24.x"
	},
	"packageManager": "pnpm@12.10.1"
}
