	"times": {},
	"ingredientSections": [
		{
			"lines": [
				"1½ cups sugar",
				"¾ cup lard or butter",
				"2 eggs",
				"1 cup seedless raisins boiled using ½ cup of the raisin water in cake",
				"1 cup sour cream or butter milk",
				"½ teaspoon salt",
				"2½ teaspoon Cinnamon",
				"1 teaspoon alspice",
				"1 teaspoon Nutmeg",
				"1 teaspoon soda sifted with flour",
				"Flour enough to make stiff batter"
			]
		},
		{
