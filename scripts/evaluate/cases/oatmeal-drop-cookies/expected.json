{
	"title": "Oatmeal drop cookies",
	"source": "Mrs. Schindler",
	"times": {},
	"ingredientSections": [
		{
			"lines": [
				"2 cups oatmeal",
				"2 cups Sugar",
				"2 cups flour",
				"1 cup seeded raisins chopped fine",
				"1 teaspoon nutmeg",
				"1 cup melted butter",
				"2 Eggs well beaten",
				"¼ cup sour milk",
				"1 teaspoon Magic Soda"
			]
		}
	],
	"instructionSections": [
		{
			"steps": [
				"Mix all together dry, then add 1 cup melted butter, 2 Eggs well beaten ¼ cup sour milk, 1 teaspoon Magic Soda, Drop in pan."
			]
		}
	],
	"reviewNotes": []
}
